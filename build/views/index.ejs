<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WebRTC Live Streaming</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <style>
        .gradient-bg {
            background: linear-gradient(135deg, #EEF2FF 0%, #F5F3FF 100%);
        }

        .glass-effect {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }

        .button-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.3);
        }

        .purple-button-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(168, 85, 247, 0.3);
        }

        html,
        body {
            height: 100%;
            min-height: 100vh;
        }

        .custom-shadow {
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
    </style>
</head>

<body class="gradient-bg flex items-center justify-center min-h-screen">
    <div class="container mx-auto px-4">
        <header class="text-center mb-12">
            <h1 class="text-4xl font-bold mb-4 text-indigo-900">WebRTC Live Streaming</h1>
            <p class="text-xl text-indigo-600">Connect and stream in real-time</p>
        </header>

        <div class="max-w-2xl mx-auto glass-effect rounded-xl p-8 custom-shadow">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="text-center">
                    <button id="connectButton"
                        class="w-full button-hover transition-all duration-300 bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-4 px-6 rounded-lg flex items-center justify-center space-x-2">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <span>Broadcast Stream</span>
                    </button>
                    <p class="mt-3 text-sm text-indigo-600">Start broadcasting your live stream</p>
                </div>

                <div class="text-center">
                    <button id="viewButton"
                        class="w-full purple-button-hover transition-all duration-300 bg-purple-600 hover:bg-purple-700 text-white font-bold py-4 px-6 rounded-lg flex items-center justify-center space-x-2">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                        <span>View Stream</span>
                    </button>
                    <p class="mt-3 text-sm text-purple-600">Join an existing broadcast</p>
                </div>
            </div>
        </div>

        <footer class="text-center mt-12 text-sm text-indigo-600">
            <p>Built with WebRTC technology for high-quality, real-time communication</p>
        </footer>
    </div>

    <script>
        document.getElementById("connectButton").addEventListener("click", () => {
            const broadcastUrl = `/broadcast`;
            window.open(broadcastUrl, "_blank");
        });

        document.getElementById("viewButton").addEventListener("click", () => {
            const broadcastUrl = `/viewer`;
            window.open(broadcastUrl, "_blank");
        });
    </script>
    
</body>
</html>